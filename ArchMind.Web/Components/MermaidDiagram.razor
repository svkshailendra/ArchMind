@inject IJSRuntime JS

<div id="@_elementId" class="mermaid-diagram">
    <div class="text-secondary">
        Rendering architecture diagram...
    </div>
</div>

@code {
    [Parameter]
    public string? Diagram { get; set; }

    private readonly string _elementId =
        $"mermaid-{Guid.NewGuid():N}";

    private string? _lastRenderedDiagram;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(Diagram))
        {
            return;
        }

        if (string.Equals(
                Diagram,
                _lastRenderedDiagram,
                StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "renderMermaid",
                _elementId,
                Diagram);

            // Only mark it as rendered after JS succeeds.
            _lastRenderedDiagram = Diagram;
        }
        catch (JSException exception)
        {
            Console.Error.WriteLine(
                $"Mermaid rendering failed: {exception.Message}");
        }
    }
}
