{

  "AI": {
    "Provider": "Ollama"
  },

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2",
    "TimeoutSeconds": 180
  },

  "Groq": {
    "Endpoint": "https://api.groq.com/openai/v1",
    "Model": "llama-3.3-70b-versatile",
    "TimeoutSeconds": 180
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ArchMind": "Information"
    }
  },
  "AllowedHosts": "*"
}
